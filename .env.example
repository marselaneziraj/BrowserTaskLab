# Offline by default. Copy to .env; never commit .env or a key.
BTL_PROVIDER=openai
BTL_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_API_KEY=
# Optional: an OpenAI-compatible Responses endpoint. No other API dialect is implied.
# BTL_MODEL_BASE_URL=https://api.openai.com/v1
BTL_BASE_URL=http://127.0.0.1:8000
BTL_RUNTIME_DIR=.runtime
BTL_HEADLESS=true
BTL_ACTION_TIMEOUT_MS=2000
BTL_MAX_RETRIES=2
# Pricing is opt-in for the exact model above, documented in docs/model.md.
# BTL_PRICE_INPUT=0.75
# BTL_PRICE_CACHED=0.075
# BTL_PRICE_OUTPUT=4.50
# BTL_PRICE_MODEL=gpt-5.4-mini-2026-03-17
# BTL_PRICE_VERIFIED_ON=2026-11-09
# BTL_PRICE_SOURCE=https://developers.openai.com/api/docs/models/gpt-5.4-mini
